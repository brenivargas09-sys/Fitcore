{
  "info": {
    "name": "FitCore - API Supabase (RA U2)",
    "description": "Coleccion de pruebas de contrato de los servicios que consume FitCore (Flutter) contra Supabase: autenticacion (GoTrue) y PostgREST sobre las tablas usuarios, clases, membresias, pagos, avisos, planes e info_gimnasio. Las credenciales se inyectan por variables de entorno al ejecutar con Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "" },
    { "key": "anonKey", "value": "" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "Autenticacion",
      "item": [
        {
          "name": "Health - REST responde",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('El servicio REST responde', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Devuelve un arreglo (tabla expuesta)', function () {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "pm.test('Tiempo de respuesta menor a 1500 ms', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{anonKey}}" },
              { "key": "Authorization", "value": "Bearer {{anonKey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/rest/v1/usuarios?select=*&limit=1",
              "host": ["{{baseUrl}}"],
              "path": ["rest", "v1", "usuarios"],
              "query": [
                { "key": "select", "value": "*" },
                { "key": "limit", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Sign in (email + password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login correcto (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve access_token', function () {",
                  "  pm.expect(body).to.have.property('access_token');",
                  "});",
                  "pm.test('Devuelve usuario', function () {",
                  "  pm.expect(body).to.have.property('user');",
                  "});",
                  "if (body.access_token) {",
                  "  pm.environment.set('token', body.access_token);",
                  "  pm.collectionVariables.set('token', body.access_token);",
                  "}",
                  "if (body.user && body.user.id) {",
                  "  pm.collectionVariables.set('userId', body.user.id);",
                  "}",
                  "pm.test('Tiempo de autenticacion menor a 2000 ms', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{anonKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/v1/token?grant_type=password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "v1", "token"],
              "query": [{ "key": "grant_type", "value": "password" }]
            }
          }
        },
        {
          "name": "Login rechazado con clave invalida",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Credenciales invalidas devuelven 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{anonKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"clave-incorrecta-fitcore\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/v1/token?grant_type=password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "v1", "token"],
              "query": [{ "key": "grant_type", "value": "password" }]
            }
          }
        }
      ]
    },
